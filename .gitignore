########################################################################
# SaudiaOne IT Ready v1 - .gitignore
########################################################################

############################
# Dependencies
############################
# Installed automatically with: npm install
node_modules/

############################
# Build Output
############################
# Generated production files
dist/
build/
out/

############################
# Environment Variables
############################
# Local environment configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep template file
!.env.example

############################
# Logs
############################
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

############################
# Cache
############################
.vite/
.cache/
coverage/
.eslintcache
.prettiercache
.turbo/

############################
# TypeScript
############################
*.tsbuildinfo

############################
# Python
############################
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
ENV/

############################
# Microsoft Office Temporary Files
############################
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx

############################
# IDE / Editors
############################
.vscode/
!.vscode/extensions.json

.idea/
*.iml
*.suo
*.user
*.userossc
*.swp
*.swo

############################
# Operating System
############################
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

############################
# Temporary Files
############################
tmp/
temp/
.history/

# Security files
*.pem
*.key
serviceAccount*.json
firebase-adminsdk*.json

# Local npm config
.npmrc.local

# VS Code workspace
*.code-workspace